# ---- PayPal (sandbox) -------------------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > your app. With these blank, Preflight
# runs against a clearly labelled payout simulator instead of PayPal.
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=
# Force the simulator even when credentials are set (1 = on).
PREFLIGHT_PAYPAL_MOCK=

# ---- AG Studio --------------------------------------------------------------------
# Your AG Studio licence key (free 45-day trial: ag-grid.com/studio/license-pricing).
AG_STUDIO=

# ---- AI (OpenAI) ------------------------------------------------------------------
# Used by the extractor, rule compiler, investigator and the AG Studio agents. With no key,
# Preflight still works with code-only fallbacks and labels itself "AI off".
AG_STUDIO_OPENAI_API_KEY=
# Comma-separated model ids; the first is the default.
OPENAI_MODELS=gpt-5.4-mini
# Public-demo protection: AI requests per IP per minute, and per day in total.
AI_RATE_PER_MINUTE=20
AI_DAILY_LIMIT=2000

# ---- Preflight --------------------------------------------------------------------
# Email domain of the six demo payees. PayPal sandbox addresses look shared across developers, so
# pick a domain only you use (e.g. brightline-yourname.com) and create the sandbox Personal accounts
# with it: priya.nayar@<domain>, james.chen@, tom.becker@, aisha.khan@, diego.ruiz@, maria.lopez@.
PREFLIGHT_PAYEE_DOMAIN=example.com
# How long a held payout waits before the owner may release it without payee verification.
PREFLIGHT_COOLING_MINUTES=10
